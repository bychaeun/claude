; Engine configuration file.
; Generated for ROOM:EYE — Godot 4

config_version=5

[application]

config/name="ROOM:EYE"
config/description="2D Psychological Horror — Mobile"
run/main_scene="res://scenes/title/Title.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

GameManager="*res://scripts/GameManager.gd"
DialogueData="*res://scripts/DialogueData.gd"
RoomManager="*res://scripts/RoomManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
DialogueManager="res://scenes/ui/DialogueBox.tscn"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
